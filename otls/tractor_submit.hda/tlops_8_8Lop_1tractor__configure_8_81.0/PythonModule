def get_todays_date() -> str:
    return datetime.now().strftime("%m-%d-%y")

    
OUTPUT_PARM = "savetodirectory_directory"  # <- change if yours is different
SUBFOLDER_PARM = "subfolder"
DEPT_PARM     = "department"                 # dropdown (can be empty "")
RENDER_LITERAL = "render"

EMPTY_SENTINELS = {"", "none", "null", "nil", "n/a", "(none)", "<none>", "-", "select", "select..."}

def _normalize_optional_folder(s):
    """Return '' if s means 'no folder'; otherwise a cleaned folder name."""
    if s is None:
        return ""
    s = hou.expandString(str(s)).strip()
    if s.lower() in EMPTY_SENTINELS:
        return ""
    return s.strip("/\\")  # keep it under the intended base

def _read_menu_or_string(node, parm_name):
    """Read a parm that might be a string or a menu; return normalized folder name."""
    p = node.parm(parm_name)
    if not p:
        return ""
    # Try as string (works for string menus, too)
    try:
        s = p.evalAsString()
    except Exception:
        s = ""
    # Fallback for integer menus -> token
    if not s:
        try:
            idx = int(p.eval())
            items = p.menuItems()
            s = items[idx] if items and 0 <= idx < len(items) else ""
        except Exception:
            s = ""
    return _normalize_optional_folder(s)


def _compute_next_version_dir(base_dir_for_versions):
    """
    Scan base_dir_for_versions for folders named MM-DD-YY_V_### for *today*,
    and return base_dir_for_versions/MM-DD-YY_V_### for the next available ###.
    """
    date_str = get_todays_date()
    pattern = re.compile(rf"^{re.escape(date_str)}_V_(\d+)$")
    versions = []
    if os.path.isdir(base_dir_for_versions):
        for name in os.listdir(base_dir_for_versions):
            full = os.path.join(base_dir_for_versions, name)
            if os.path.isdir(full):
                m = pattern.match(name)
                if m:
                    try:
                        versions.append(int(m.group(1)))
                    except ValueError:
                        pass
    next_v = (max(versions) + 1) if versions else 1
    return os.path.join(base_dir_for_versions, f"{date_str}_V_{next_v:03d}")
def strip_trailing_render(path: str) -> str:
    """
    If the last segment is 'render' (case-insensitive), remove it.
    Preserves a trailing slash if the input had one.
    """
    had_trailing = path.endswith(("/", "\\"))
    p = path.replace("\\", "/").rstrip("/")             # normalize + trim
    head, tail = p.rsplit("/", 1) if "/" in p else ("", p)
    if tail.lower() == "render":
        out = head or "/"                               # handle root edge-case
    else:
        out = p
    return (out + "/") if had_trailing else out
def strip_after_render(path: str) -> str:
    """
    Return the portion of `path` that comes *before* the first 'render' segment.
    If 'render' is not found, returns the normalized path as-is.
    """
    p = path.replace("\\", "/").strip()
    if not p:
        return p
    segs = [s for s in p.split("/") if s]  # drop empty
    try:
        idx = next(i for i, s in enumerate(segs) if s.lower() == "render")
        # keep everything *before* 'render'
        kept = segs[:idx]
        if not kept:
            return "/"  # edge-case: '/render/...'
        return "/" + "/".join(kept)
    except StopIteration:
        # no 'render' segment -> return root as-is
        return p

def build_output_path_from_default_base(node):
    # $HOUDINI_TEMP_DIR/usd_renders/$RENDERID/<department?>/render/MM-DD-YY_V_###/<subfolder?>
    template = node.parm("savetodirectory_directory").unexpandedString()
    if not template:
        template = "$HIP"

    # 2) Do the same expansion HScript would have done:
    root = hou.expandString(template)  # expands $HOUDINI_TEMP_DIR, $HIP, $JOB, etc.
    root = strip_after_render(root)
    dept = _read_menu_or_string(node, "department")      # now '' when empty
    sub  = _read_menu_or_string(node, "subfolder")       # may be ''

    base_for_versions = os.path.join(root, "render") if not dept \
                        else os.path.join(root, dept, "render")

    version_dir = _compute_next_version_dir(base_for_versions)

    final_path = os.path.join(version_dir, sub) + "/" if sub else version_dir
    return final_path.replace("\\", "/")

def create_folders(node, set_parm=True):
    """
    mkdir -p the computed path (creates dept/render if missing, and the version/subfolder).
    Optionally writes it to OUTPUT_PARM.
    """
    path = build_output_path_from_default_base(node)
    os.makedirs(path, exist_ok=True)
    if set_parm and node.parm(OUTPUT_PARM):
        node.parm(OUTPUT_PARM).set(path)
    return path

def _assert_node(n: hou.Node | None, label: str) -> hou.Node:
    if n is None:
        raise hou.NodeError(f"Tractor config: could not resolve {label}")
    return n

def _find_usdrender_node(root: hou.Node) -> hou.Node | None:
    # 1) exact child by expected name
    n = root.node("usdrender_rop")
    if n: return n

    # 2) optional parameter that stores a path (add this parm to your HDA if you want)
    p = root.parm("usdrender_rop_path")
    if p:
        n = p.evalAsNode()
        if n: return n

    # 3) search descendants by common type/name hints
    for cand in root.allSubChildren():
        tname = cand.type().name()
        if tname in {"usd_rop", "usdrender_rop"}:
            return cand
        if cand.name() == "usdrender_rop":
            return cand
        # Anything that has an obvious render/execute button is a candidate
        if any(cand.parm(x) is not None for x in ("execute", "render", "renderbutton")):
            return cand

    return None

def _press_render_button(n: hou.Node) -> None:
    # Try common button parm names first
    for pname in ("execute", "render", "renderbutton"):
        p = n.parm(pname)
        if p is not None:
            p.pressButton()
            return
    # Fallback: press the first button parm we can find
    for parm in n.parms():
        try:
            if parm.parmTemplate().type() == hou.parmTemplateType.Button:
                parm.pressButton()
                return
        except Exception:
            pass
    raise hou.NodeError(f"Tractor config: found {n.path()} but no render/execute button on it")



def generate_tractor_task(node: hou.LopNode, submit_input: hou.LopNode) -> author.Task:
    task = author.Task(title=node.name())
    parms = ConfigureParms(node)
    service = parms.service.strip()

    # 1) Find render node
    render_node = _assert_node(_find_usdrender_node(node), f"'usdrender_rop' under {node.path()}")

    # 2) Set up logs (safe)
    command_list: list[str] = []
    sink = set_up_logs(command_list, None)  # use permissive COMMAND_RE

    # 3) Kick the render
    _press_render_button(render_node)

    # 4) Wait briefly for *some* command to show up; don't block forever
    expected = get_frame_count(node) or 0
    deadline = time.time() + 10.0  # seconds
    while not command_list and time.time() < deadline:
        time.sleep(0.05)

    # 5) If logs didn't yield useful commands, synthesize them from the ROP
    cmds: list[list[str]] = []
    if command_list:
        # Parse each captured command string into argv safely
        for c in command_list:
            try:
                parts = shlex.split(c)
                if parts and parts[0].endswith("husk"):
                    cmds.append(parts)
            except Exception:
                pass

    if not cmds:
        # Fallback: deterministically build from parms
        cmds = _husk_commands_from_rop(render_node)

    # 6) Build Tractor subtasks
    for parts in cmds:
        # Try to extract frame number for the subtask title
        try:
            fnum = parts[parts.index("-f") + 1]
        except Exception:
            fnum = "?"
        subtask = author.Task(title=f"Frame {fnum}")
        command_kwargs = {
            "argv": [
                "/bin/bash",
                "-exc",
                "hserver -S animlic.cs.byu.edu && " + " ".join(parts),
            ]
        }
        if service:
            command_kwargs["service"] = service
        subtask.addCommand(author.Command(**command_kwargs))
        task.addChild(subtask)

    # 7) Clean up the log hook to avoid duplicate callbacks next run
    try:
        sink.setFilterCallback(None)
    except Exception:
        pass

    return task
