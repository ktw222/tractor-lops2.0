# permissive default; matches:  ... command: "husk -f 100 ..."  (quotes optional)
COMMAND_RE = re.compile(r"command:\s*(?:\"|')?(husk\b.*)", re.IGNORECASE)



def set_up_logs(output_list, regex=None):
    """
    Hook Houdini's default log sink and append matched husk commands to output_list.
    regex can be:
      - None (use COMMAND_RE),
      - a string pattern,
      - or a compiled re.Pattern.
    Returns the sink so you can detach the callback later.
    """
    # Decide which pattern to use
    if isinstance(regex, re.Pattern):
        pattern = regex
    elif isinstance(regex, str) and regex.strip():
        pattern = re.compile(regex, re.IGNORECASE)
    else:
        pattern = COMMAND_RE

    def log_sink_filter(log: hou.logging.LogEntry) -> bool:
        try:
            msg = log.message()
            m = pattern.search(msg)   # search anywhere in the line
            if m:
                # Only append if a capturing group exists; else use whole match
                try:
                    output_list.append(m.group(1))
                except IndexError:
                    output_list.append(m.group(0))
        except Exception:
            # Never let the callback raise; swallow & keep logs flowing
            pass
        return False  # don't swallow other sinks

    sink = hou.logging.defaultSink(True)
    sink.connect("Standard Output")
    sink.setFilterCallback(log_sink_filter)
    return sink

def _int_parm(node, name, default):
    p = node.parm(name)
    if not p: return default
    try: return int(p.eval())
    except Exception: return default

def _str_parm(node, name, default=""):
    p = node.parm(name)
    if not p: return default
    try: return p.evalAsString()
    except Exception: return default

def _husk_commands_from_rop(rop: hou.Node) -> list[list[str]]:
    """
    Derive husk argv from common USD Render parms. Adjust parm names to your HDA as needed.
    """
    # Common frame parms on usdrender/usd_rop
    trange = _str_parm(rop, "trange", "off")  # "off", "normal", "on", "stage"
    f1 = _int_parm(rop, "f1", int(hou.frame()))
    f2 = _int_parm(rop, "f2", f1)
    f3 = max(1, _int_parm(rop, "f3", 1))

    # Try plausible output/USD parms in order
    usd_path = (_str_parm(rop, "lopoutput") or
                _str_parm(rop, "lopoutputpath") or
                _str_parm(rop, "picture") or
                _str_parm(rop, "output") or
                "")
    if not usd_path:
        raise hou.NodeError(f"{rop.path()}: could not determine USD path/output parm")

    cam = _str_parm(rop, "camera", "")
    renderer = _str_parm(rop, "renderer", "")

    base = ["husk", usd_path]
    if cam:      base += ["-c", cam]
    if renderer: base += ["-R", renderer]

    cmds: list[list[str]] = []
    if trange in ("normal", "on") and f2 >= f1:
        for f in range(f1, f2 + 1, f3):
            cmds.append(base + ["-f", str(f)])
    else:
        cmds.append(base + ["-f", str(f1)])
    return cmds

