def get_frame_count(node: hou.LopNode) -> int:
    trange = node.parm("trange").evalAsString()

    if trange == "off":
        return 1
    elif trange == "normal" or trange == "on":
        start = node.parm("f1").evalAsFloat()
        end = node.parm("f2").evalAsFloat()
        inc = node.parm("f3").evalAsFloat()
    elif trange == "stage":
        stage = node.stage()
        start = stage.GetStartTimeCode() - node.parm("foffset1").evalAsFloat()
        end = stage.GetEndTimeCode() + node.parm("foffset2").evalAsFloat()
        inc = node.parm("foffset3").evalAsFloat()
        
def generate_tractor_task(node: hou.LopNode, submit_input: hou.LopNode) -> author.Task:
    task = author.Task(title=node.name())
    parms = ConfigureParms(node)
    service = parms.service.strip()

    render_node = _assert_node(_find_usdrender_node(node), f"'usdrender_rop' under {node.path()}")

    command_list: list[str] = []
    sink = set_up_logs(command_list)   # <-- no second arg; uses COMMAND_RE

    _press_render_button(render_node)

    # bounded wait (avoid UI hang)
    expected = get_frame_count(node) or 0
    deadline = time.time() + 10.0
    while not command_list and time.time() < deadline:
        time.sleep(0.05)

    # parse or synthesize commands
    cmds: list[list[str]] = []
    for c in command_list:
        try:
            parts = shlex.split(c)
            if parts and parts[0].endswith("husk"):
                cmds.append(parts)
        except Exception:
            pass
    if not cmds:
        cmds = _husk_commands_from_rop(render_node)  # your helper

    # build subtasks
    for parts in cmds:
        try:
            fnum = parts[parts.index("-f") + 1]
        except Exception:
            fnum = "?"
        sub = author.Task(title=f"Frame {fnum}")
        command_kwargs = {
            "argv": [
                "/bin/bash",
                "-exc",
                "hserver -S animlic.cs.byu.edu && " + " ".join(parts),
            ]
        }
        if service:
            command_kwargs["service"] = service
        sub.addCommand(author.Command(**command_kwargs))
        task.addChild(sub)

    # detach callback so subsequent runs don't double-hook
    try:
        sink.setFilterCallback(None)
    except Exception:
        pass

    return task

    if (start == 0.0) and (end == 0.0):
        return 0

    return (end + 1 - start) // inc

